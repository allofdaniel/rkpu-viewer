# RKPU-Viewer 환경변수 설정
# 이 파일을 .env로 복사하고 실제 값을 입력하세요

# ===========================================
# Mapbox 설정
# ===========================================
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# ===========================================
# 외부 API 키
# ===========================================
# 기상청 API (apihub.kma.go.kr)
KMA_API_KEY=your_kma_api_key_here

# aviationstack API (선택)
VITE_AVIATIONSTACK_API_KEY=your_aviationstack_key_here

# OpenSky Network OAuth2 (선택 - 히스토리 데이터용)
OPENSKY_CLIENT_ID=your_opensky_client_id
OPENSKY_CLIENT_SECRET=your_opensky_client_secret

# ===========================================
# Supabase 설정 (NOTAM DB + Storage)
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# ===========================================
# 앱 설정
# ===========================================
# API 기본 URL (Vercel 배포 URL)
VITE_API_BASE_URL=https://rkpu-viewer.vercel.app

# 개발 환경 설정
NODE_ENV=development

# ===========================================
# 보안 설정
# ===========================================
# CORS 허용 도메인 (콤마로 구분)
CORS_ALLOWED_ORIGINS=https://rkpu-viewer.vercel.app,http://localhost:5173

# Rate Limiting (분당 요청 수)
RATE_LIMIT_MAX=100
